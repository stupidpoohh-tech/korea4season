{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "korea4season",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],

  // OpenNext 가 생성한 정적 자산(빌드 산출물 + public/)
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // ISR 증분 캐시.
  // 이 캐시가 없으면 빌드 시점의 "오늘" 이 그대로 굳는다 —
  // 모든 라우트가 revalidate = 900 인 이유가 날짜 갱신 하나이기 때문이다.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "0bbbc1e9c7bc4aabb6a54946411e1e78"
    }
  ]
}
