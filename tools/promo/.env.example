# 아니그래서 홍보 숏츠 도구 — 로컬 전용 설정
# ★ 이 파일(.env.example)만 커밋한다. 값이 든 .env 는 .gitignore 가 막는다.

# Typecast Timestamp TTS (--real 에서만 쓴다. mock·preview 는 키가 없어도 돈다)
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
TYPECAST_MODEL=
TYPECAST_LANGUAGE=kor
TYPECAST_TEMPO=
TYPECAST_PITCH=
TYPECAST_VOLUME=

# 렌더에 쓸 크로미움. 비워 두면 Playwright 가 받아 둔 것을 찾아 쓴다.
#   Windows 예: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_EXECUTABLE=

# 제품 화면 캡처 (capture/capture.mjs)
CAPTURE_BASE_URL=http://localhost:5173
FIRESTORE_EMULATOR_HOST=localhost:8080
CAPTURE_PROJECT_ID=demo-seongsu
