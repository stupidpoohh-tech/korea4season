    { "id": "src:local-notice", "name": "시·도지사 고시 (해역별 조정)", "url": "https://www.mof.go.kr", "documentType": "local-notice", "note": "지역별 고시는 매년 갱신됩니다. 관할 지자체 공고를 확인하십시오." }
